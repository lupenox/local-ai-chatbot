{
  "name": "local-ai-chatbot-ui",
  "version": "1.0.0",
  "description": "A privacy-first local multi-model AI assistant built with React, Electron, Flask, Hugging Face, and Ollama.",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run electron\" \"npm run react\"",
    "react": "cd ui && npm start",
    "electron": "wait-on http://localhost:3000 && electron .",
    "build": "cd ui && npm run build",
    "package": "electron-packager . local-ai-chatbot --platform=linux --arch=x64 --out=dist --overwrite"
  },
  "author": "Logan Lapierre",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^8.2.0",
    "electron": "^27.1.2",
    "wait-on": "^7.0.1"
  },
  "devDependencies": {
    "electron-packager": "^17.1.1"
  },
  "allowScripts": {
    "electron@27.3.11": true
  }
}
